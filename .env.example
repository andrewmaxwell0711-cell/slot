# Stripe TEST-MODE keys only. Used for the coin shop. The server refuses to
# start if STRIPE_SECRET_KEY is set and does not begin with sk_test_.
# Live keys (sk_live_) are never accepted. Leave unset to run without the shop.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Used to build Checkout success/cancel URLs if the request host is wrong.
# PUBLIC_BASE_URL=http://localhost:8765
